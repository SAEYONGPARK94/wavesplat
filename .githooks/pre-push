#!/bin/sh
# ⚠[2026-09-03] LFS 추적을 HEAD 이후로 걷어냈다. 그러나 **재작성 이전 이력**에는
#   여전히 LFS 포인터가 있어 훅 자체는 남긴다.
#   ⛔단 초판은 git-lfs 가 없으면 `exit 2` 로 **커밋·체크아웃·머지·푸시를 전부 막았다**.
#   ⟹ **fail-open 으로 바꾼다**: 없으면 조용히 건너뛴다(옛 포인터는 평범한 텍스트로 남는다).
# ⛔[2026-09-03 2차 감사] 넷 중 **`pre-push` 만 차단력이 있다**(post-* 는 git 이
#   종료코드를 무시한다). 그리고 `main` 에는 LFS 포인터가 **아직 남아 있다** ⟹
#   git-lfs 없는 기계에서 push 하면 업로드를 조용히 건너뛰어 원격에 **객체 없는
#   포인터**가 올라간다. 옛 `exit 2` 는 그걸 막았다.
#   ⟹ fail-open 은 유지하되 **침묵하지 않는다**(저장소 규율: 침묵 스킵이 반복 결함).
command -v git-lfs >/dev/null 2>&1 || {
  echo >&2 "[pre-push] ⛔git-lfs 가 없어 LFS 업로드를 건너뜁니다."
  echo >&2 "           이 이력에 LFS 포인터가 남아 있으면 원격에 객체 없는"
  echo >&2 "           포인터가 올라갈 수 있습니다. git-lfs 설치 후 다시 push 하세요."
  exit 0
}
git lfs pre-push "$@"
