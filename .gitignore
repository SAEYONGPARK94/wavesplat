# Office lock files
~$*

# Large generated data / model artifacts
wavesplat/cache/
wavesplat/checkpoints/
wavesplat/data/nn_train*.npz
wavesplat/data/usgo_train.npz

# External library clones (not submodules)
external/gridded-tnp/

# Externally sourced raw datasets (42 GB; re-download per
# docs reference_bergamasco_stereo_dataset)
wavesplat/data/real_bergamasco/

# Training-set caches and scratch training runs (regenerable from seeds)
wavesplat/data/fixed_train.npz
wavesplat/tmp/prior_train/
wavesplat/tmp/e1_windows/

# Numeric caches / intermediate arrays (regenerable)
*.npz
*.npy
*.nc

# Model checkpoints. Regenerable, so ignored by default; a checkpoint that a
# result depends on is added deliberately with `git add -f`.
*.pt

# graphify knowledge-graph outputs (rebuildable with `/graphify`; graph.json
# alone is ~8 MB and churns on every run)
graphify-out/

# FRF lidar raw downloads (re-downloadable from chldata.erdc.dren.mil THREDDS)
wavesplat/tmp/frf_lidar_2026-08-01/*.nc
wavesplat/tmp/frf_lidar_2026-08-01/*.xml

# Regenerable artifacts (code + seeds reproduce these) — 2026-08-21
*.gif
wavesplat/tmp/fowd_2026-08-02/venv_fowd/

